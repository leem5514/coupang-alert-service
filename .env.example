# 데이터 공급자
# demo: 실제 쇼핑몰 호출 없이 시뮬레이션 가격 사용
# external: 이용 허가를 받은 JSON 가격 API 사용
PRICE_PROVIDER=demo

# external Provider 계약
# GET {PRICE_API_URL}?q=검색어
# Authorization: Bearer {PRICE_API_KEY}
# 응답: { "items": [{ "id", "name", "price", "seller", "url", "imageUrl"? }] }
PRICE_API_URL=
PRICE_API_KEY=

# 같은 검색 조건 결과를 공유하는 캐시 시간 (기본 10분)
PRICE_CACHE_MS=600000

# 이메일 알림 (Gmail 앱 비밀번호 사용)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password_here

# 동일 상품 알림 재발송 간격 (기본 24시간)
NOTIFICATION_COOLDOWN_MS=86400000
PORT=3000
